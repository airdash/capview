layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D inputTex;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D outputImg;

layout(push_constant) uniform PC {
    uint rcasCon;   // packed sharpness (exp2(-stops), 1.0 = max sharp)
    uint dstW, dstH;
    uint pad0;
    float brightness, contrast, invGamma;
    float pad1;
};

// AMD ffx_a.h helpers
float APrxLoRcpF1(float a) { return uintBitsToFloat(uint(0x7ef07ebb) - floatBitsToUint(a)); }
float APrxMedRcpF1(float a) {
    float b = uintBitsToFloat(uint(0x7ef19fff) - floatBitsToUint(a));
    return b * (-b * a + 2.0);
}
float AMin3F1(float x, float y, float z) { return min(x, min(y, z)); }
float AMax3F1(float x, float y, float z) { return max(x, max(y, z)); }

// RCAS limit — set at the limit of providing unnatural results for sharpening
#define FSR_RCAS_LIMIT (0.25 - (1.0 / 16.0))

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (pos.x >= int(dstW) || pos.y >= int(dstH)) return;

    // 3×3 neighborhood:
    //    b
    //  d e f
    //    h
    vec3 b = texelFetch(inputTex, pos + ivec2( 0, -1), 0).rgb;
    vec3 d = texelFetch(inputTex, pos + ivec2(-1,  0), 0).rgb;
    vec3 e = texelFetch(inputTex, pos,                 0).rgb;
    vec3 f = texelFetch(inputTex, pos + ivec2( 1,  0), 0).rgb;
    vec3 h = texelFetch(inputTex, pos + ivec2( 0,  1), 0).rgb;

    // Luma × 2 (AMD's approximate luma, matching EASU)
    float bL = b.b * 0.5 + (b.r * 0.5 + b.g);
    float dL = d.b * 0.5 + (d.r * 0.5 + d.g);
    float eL = e.b * 0.5 + (e.r * 0.5 + e.g);
    float fL = f.b * 0.5 + (f.r * 0.5 + f.g);
    float hL = h.b * 0.5 + (h.r * 0.5 + h.g);

    // Noise detection (highpass normalized against local contrast)
    float nz = 0.25 * bL + 0.25 * dL + 0.25 * fL + 0.25 * hL - eL;
    nz = clamp(abs(nz) * APrxMedRcpF1(AMax3F1(AMax3F1(bL, dL, eL), fL, hL)
                                      - AMin3F1(AMin3F1(bL, dL, eL), fL, hL)),
               0.0, 1.0);
    nz = -0.5 * nz + 1.0;

    // Per-channel min/max of ring
    float mn4R = min(AMin3F1(b.r, d.r, f.r), h.r);
    float mn4G = min(AMin3F1(b.g, d.g, f.g), h.g);
    float mn4B = min(AMin3F1(b.b, d.b, f.b), h.b);
    float mx4R = max(AMax3F1(b.r, d.r, f.r), h.r);
    float mx4G = max(AMax3F1(b.g, d.g, f.g), h.g);
    float mx4B = max(AMax3F1(b.b, d.b, f.b), h.b);

    // Per-channel lobe weight computation (high precision reciprocals)
    vec2 peakC = vec2(1.0, -4.0);
    float hitMinR = min(mn4R, e.r) / (4.0 * mx4R);
    float hitMinG = min(mn4G, e.g) / (4.0 * mx4G);
    float hitMinB = min(mn4B, e.b) / (4.0 * mx4B);
    float hitMaxR = (peakC.x - max(mx4R, e.r)) / (4.0 * mn4R + peakC.y);
    float hitMaxG = (peakC.x - max(mx4G, e.g)) / (4.0 * mn4G + peakC.y);
    float hitMaxB = (peakC.x - max(mx4B, e.b)) / (4.0 * mn4B + peakC.y);
    float lobeR = max(-hitMinR, hitMaxR);
    float lobeG = max(-hitMinG, hitMaxG);
    float lobeB = max(-hitMinB, hitMaxB);

    // Combine per-channel lobes, clamp, and apply sharpness multiplier
    float lobe = max(-FSR_RCAS_LIMIT, min(AMax3F1(lobeR, lobeG, lobeB), 0.0))
               * uintBitsToFloat(rcasCon);

    // Apply noise removal
    lobe *= nz;

    // Resolve with medium precision reciprocal
    float rcpL = APrxMedRcpF1(4.0 * lobe + 1.0);
    vec3 result;
    result.r = (lobe * b.r + lobe * d.r + lobe * h.r + lobe * f.r + e.r) * rcpL;
    result.g = (lobe * b.g + lobe * d.g + lobe * h.g + lobe * f.g + e.g) * rcpL;
    result.b = (lobe * b.b + lobe * d.b + lobe * h.b + lobe * f.b + e.b) * rcpL;

    // Apply brightness, contrast, gamma (post-sharpening adjustments)
    result = clamp(((result - 0.5) * contrast + 0.5) * brightness, 0.0, 1.0);
    result = pow(result, vec3(invGamma));

    imageStore(outputImg, pos, vec4(result, 1.0));
}
